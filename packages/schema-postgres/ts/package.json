{
  "name": "boilpayment-schema-postgres",
  "version": "0.3.0",
  "private": true,
  "description": "boilpayment — schema-postgres",
  "license": "MIT",
  "keywords": [
    "schift",
    "payment-kit",
    "payments",
    "postgres",
    "ledger",
    "migrations",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/sql && cp ../sql/*.sql dist/sql/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prebuild": "node ../scripts/sync-sql.mjs"
  },
  "dependencies": {
    "boilpayment-core": "workspace:*",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/schift-io/boilpayment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schift-io/boilpayment.git"
  },
  "bugs": {
    "url": "https://github.com/schift-io/boilpayment/issues"
  }
}
