{
  "name": "boilpayment-notify",
  "version": "0.3.0",
  "private": true,
  "description": "boilpayment — notify",
  "license": "MIT",
  "keywords": [
    "schift",
    "payment-kit",
    "payments",
    "notifications",
    "email",
    "slack",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "boilpayment-core": "workspace:*",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/schift-io/boilpayment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schift-io/boilpayment.git"
  },
  "bugs": {
    "url": "https://github.com/schift-io/boilpayment/issues"
  }
}
