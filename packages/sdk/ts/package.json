{
  "name": "boilpayment-sdk",
  "version": "0.2.1",
  "description": "boilpayment — self-contained TypeScript SDK exposing every module via subpaths",
  "license": "MIT",
  "keywords": [
    "schift",
    "payment-kit",
    "payments",
    "billing",
    "subscriptions",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./credits": {
      "types": "./dist/credits.d.ts",
      "import": "./dist/credits.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./refund": {
      "types": "./dist/refund.d.ts",
      "import": "./dist/refund.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "import": "./dist/notify.js"
    },
    "./cs": {
      "types": "./dist/cs.d.ts",
      "import": "./dist/cs.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "import": "./dist/stripe.js"
    },
    "./toss": {
      "types": "./dist/toss.d.ts",
      "import": "./dist/toss.js"
    },
    "./portone": {
      "types": "./dist/portone.d.ts",
      "import": "./dist/portone.js"
    },
    "./polar": {
      "types": "./dist/polar.d.ts",
      "import": "./dist/polar.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/pg": "^8.11.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.13.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/schift-io/boilpayment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schift-io/boilpayment.git"
  },
  "bugs": {
    "url": "https://github.com/schift-io/boilpayment/issues"
  }
}
